# Copy this file to .env and fill in your keys.
SPEECHMATICS_API_KEY=
GROQ_API_KEY=
# B-roll planning and image prompts: Gemini (default) or Groq. One of the two is enough.
GEMINI_API_KEY=

# Optional
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_REASONING_EFFORT=medium
# PORT=3000
# WORKSPACE_DIR=workspace
# Optional: lets the Captions tab download Google Fonts as plain .ttf files through Google's official API.
# Without it the app asks Google's website for them, which usually works too.
# GOOGLE_FONTS_API_KEY=

# Optional: B-roll
# GEMINI_MODEL=gemini-2.5-flash
# FLOW_URL=https://labs.google/fx/tools/flow
# FLOW_CDP_URL=http://127.0.0.1:9222
# CHROME_PATH=
# FFMPEG_PATH=
# Keep the PC responsive while ffmpeg works (default: all cores but two, below-normal priority)
# FFMPEG_THREADS=
# FFMPEG_PRIORITY=normal
