{
  "flowUrl": "https://labs.google/fx/tools/flow",
  "cdpUrl": "http://127.0.0.1:9222",
  "dailyLimit": 60,
  "minImageSize": 400,
  "expectedPerPrompt": 0,
  "generationTimeoutMs": 240000,
  "settleMs": 8000,
  "betweenPromptsMs": 4000,
  "submitWithEnterFallback": true,
  "strictModel": false,
  "selectors": {
    "promptBox": [
      "textarea",
      "[role='textbox']",
      "[contenteditable='true']"
    ],
    "submitButton": [],
    "newProjectButton": [
      "button:has-text('New project')",
      "button:has-text('Create project')",
      "[aria-label*='new project' i]"
    ],
    "settingsButton": [],
    "modelDropdown": [],
    "addButton": [],
    "uploadButton": [
      "button:has-text('Upload media')",
      "[role='button']:has-text('Upload media')",
      "text=Upload media"
    ],
    "addToPromptButton": [
      "button:has-text('Add to prompt')",
      "[role='button']:has-text('Add to prompt')"
    ],
    "assetSearch": [
      "input[placeholder*='Search assets' i]",
      "input[placeholder*='Search' i]"
    ]
  },
  "limitTextPatterns": [
    "daily limit",
    "limit reached",
    "quota",
    "out of credits",
    "try again tomorrow"
  ],
  "ratios": [
    "16:9",
    "4:3",
    "1:1",
    "3:4",
    "9:16"
  ],
  "models": [
    "Nano Banana Pro",
    "Nano Banana 2 Lite",
    "Nano Banana 2.1"
  ],
  "defaults": {
    "ratio": "16:9",
    "model": "Nano Banana 2.1",
    "count": 2
  },
  "maxReferenceImages": 3,
  "asr": {
    "baseUrl": "https://asr.api.speechmatics.com/v2",
    "pollMs": 3000,
    "defaultModel": "enhanced",
    "defaultLanguage": "en",
    "models": [
      {
        "id": "enhanced",
        "label": "Enhanced: highest accuracy, one language"
      },
      {
        "id": "melia-1",
        "label": "Melia 1: multilingual / mixed languages"
      },
      {
        "id": "standard",
        "label": "Standard: fastest"
      }
    ]
  },
  "llm": {
    "defaultProvider": "groq",
    "providers": {
      "gemini": {
        "label": "Gemini",
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "default": "gemini-2.5-flash",
        "models": [
          "gemini-2.5-flash"
        ]
      },
      "groq": {
        "label": "Groq",
        "baseUrl": "https://api.groq.com/openai/v1",
        "default": "openai/gpt-oss-20b",
        "models": [
          "openai/gpt-oss-20b"
        ]
      },
      "claude": {
        "label": "Claude (claude.ai)",
        "web": true,
        "default": "claude.ai chat",
        "models": [
          "claude.ai chat"
        ]
      }
    }
  },
  "planning": {
    "chunkWords": 600,
    "promptBatchSize": 40,
    "selectBatchSize": 120,
    "cardBatchSize": 8
  },
  "skipSettings": false,
  "settingsStepTimeoutMs": 15000,
  "themes": {
    "default": "card",
    "legacy": "free"
  },
  "claude": {
    "newChatUrl": "https://claude.ai/new",
    "chatUrlPattern": "^https://claude\\.ai/chat/[0-9a-f-]{36}",
    "newChatEvery": 0,
    "newChatPerVideo": true,
    "combineChooseCards": false,
    "replyTimeoutMs": 300000,
    "settleMs": 2500,
    "stuckMs": 25000,
    "maxContinues": 4,
    "chunkWords": 1000,
    "selectBatchSize": 150,
    "cardBatchSize": 40,
    "promptBatchSize": 12,
    "limitTextPatterns": [
      "usage limit",
      "limit reached",
      "message limit",
      "you've reached",
      "try again later"
    ],
    "selectors": {
      "input": [
        "div[contenteditable='true'][role='textbox']",
        "div.ProseMirror[contenteditable='true']",
        "[contenteditable='true']",
        "textarea"
      ],
      "send": [
        "button[aria-label='Send message']",
        "button[aria-label*='Send' i]"
      ],
      "stop": [
        "button[aria-label='Stop response']",
        "button[aria-label*='Stop' i]"
      ],
      "assistantMessage": [
        "[data-is-streaming]",
        "div.font-claude-response",
        "div[class*='font-claude']"
      ],
      "copyButton": [
        "button[aria-label='Copy']",
        "button[data-testid='action-bar-copy']"
      ],
      "continueButton": [
        "button:has-text('Continue')"
      ],
      "loginMarker": [
        "input[type='email']",
        "button:has-text('Continue with Google')"
      ]
    }
  },
  "ultraKey": {
    "enabled": true,
    "color": "0x00FF00",
    "similarity": 0.3,
    "blend": 0.1,
    "despill": true,
    "modes": [
      "ui",
      "material",
      "symbol"
    ]
  },
  "claudeCut": { "maxCutRatio": 0.25, "longWholeWords": 12, "pauseFlagSec": 0.8, "partMaxWords": 6000, "contextSegments": 10, "maxVerifyItems": 60 }
}
